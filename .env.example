# Postgres connection string. Works with any standard Postgres — Vercel
# Postgres, Neon, Supabase, Railway, Render, or a self-hosted instance.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Set to "true" if your provider requires SSL with a self-signed cert
# (common for managed Postgres). Leave unset for local Postgres.
# DATABASE_SSL="true"
