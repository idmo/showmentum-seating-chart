# Copy this to .env (same directory as docker-compose.yml) and adjust.
# docker compose reads .env automatically for the ${...} values in
# docker-compose.yml — this is separate from .env.local, which is only
# used by `npm run dev` outside Docker.

POSTGRES_USER=escort
POSTGRES_PASSWORD=change-me
POSTGRES_DB=escort_chart

# The host port the app is published on (http://localhost:APP_PORT).
APP_PORT=3000

# The host port Postgres is published on — only needs to change if
# something else on your machine is already using 5432.
DB_PORT=5432
